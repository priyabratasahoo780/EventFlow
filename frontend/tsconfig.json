{
  "extends": "./node_modules/expo/tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-native",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*":            ["./*"],
      "@/components":   ["./components"],
      "@/components/*": ["./components/*"],
      "@/constants":    ["./constants"],
      "@/constants/*":  ["./constants/*"],
      "@/hooks":        ["./hooks"],
      "@/hooks/*":      ["./hooks/*"],
      "@/models":       ["./models"],
      "@/models/*":     ["./models/*"],
      "@/services":     ["./services"],
      "@/services/*":   ["./services/*"],
      "@/store":        ["./store"],
      "@/store/*":      ["./store/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
