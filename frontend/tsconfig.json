{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*":            ["./src/*"],
      "@/components":   ["./src/components"],
      "@/components/*": ["./src/components/*"],
      "@/constants":    ["./src/constants"],
      "@/constants/*":  ["./src/constants/*"],
      "@/hooks":        ["./src/hooks"],
      "@/hooks/*":      ["./src/hooks/*"],
      "@/lib":          ["./src/lib"],
      "@/lib/*":        ["./src/lib/*"],
      "@/services":     ["./src/services"],
      "@/services/*":   ["./src/services/*"],
      "@/store":        ["./src/store"],
      "@/store/*":      ["./src/store/*"],
      "@/types":        ["./src/types"],
      "@/types/*":      ["./src/types/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
