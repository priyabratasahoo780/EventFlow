{
  "expo": {
    "name": "EventFlow",
    "slug": "FocusFlow",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon_squared.png",
    "scheme": "eventflow",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.priyabrata.eventflow"
    },
    "notification": {
      "icon": "./assets/images/android-icon-monochrome.png",
      "color": "#6366F1"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "newArchEnabled": true,
      "versionCode": 5,
      "permissions": [
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "USE_FULL_SCREEN_INTENT",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "ACTIVITY_RECOGNITION",
        "com.google.android.gms.permission.ACTIVITY_RECOGNITION",
        "ACCESS_NOTIFICATION_POLICY",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.priyabrata.eventflow"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#6366F1"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "packagingOptions": {
              "pickFirst": [
                "**/META-INF/versions/9/OSGI-INF/MANIFEST.MF",
                "**/META-INF/MANIFEST.MF",
                "**/META-INF/DEPENDENCIES",
                "**/META-INF/LICENSE",
                "**/META-INF/NOTICE"
              ]
            }
          }
        }
      ],
      "expo-sharing",
      "expo-status-bar",
      "expo-video",
      "expo-audio",
      "./plugins/withAlarmManager.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6411eb54-9029-40e7-8968-5c5963b9de78"
      }
    },
    "runtimeVersion": "2.0.0",
    "updates": {
      "url": "https://u.expo.dev/6411eb54-9029-40e7-8968-5c5963b9de78"
    },
    "owner": "bharatshah786"
  }
}
