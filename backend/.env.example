PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/eventflow
JWT_SECRET=replace_with_strong_random_secret
CLERK_SECRET_KEY=sk_test_replace_if_used
EXPO_ACCESS_TOKEN=

# Free HTTPS Email API (Recommended for Render Free Tier where SMTP ports 587/465 are blocked)
# BREVO_API_KEY=xkeysib-your-brevo-api-key
# RESEND_API_KEY=re_your_resend_api_key

# Free Gmail SMTP (500 OTPs/day free using Google 16-char App Password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=abcd efgh ijkl mnop
EMAIL_FROM="EventFlow Security <your_email@gmail.com>"

# Optional: Multi-Gmail round-robin pool (500/day per account)
# EMAIL_ACCOUNTS=mail1@gmail.com:pass1,mail2@gmail.com:pass2

# Optional: Custom SMTP server (leave empty when using Gmail)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false

# Admin Portal Account (Auto-seeded on startup)
ADMIN_EMAIL=admin@eventflow.app
ADMIN_PASSWORD=replace_with_strong_admin_password

# Cloudinary Cloud Storage (Free Tier: 25GB quota, auto-compression)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
