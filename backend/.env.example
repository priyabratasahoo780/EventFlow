PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/eventflow
JWT_SECRET=replace_with_strong_random_secret
CLERK_SECRET_KEY=sk_test_replace_if_used
EXPO_ACCESS_TOKEN=

# Free Gmail SMTP (500 OTPs/day free using Google 16-char App Password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=abcd efgh ijkl mnop
EMAIL_FROM="EventFlow Security <your_email@gmail.com>"

# Optional: Multi-Gmail round-robin pool (500/day per account)
# EMAIL_ACCOUNTS=mail1@gmail.com:pass1,mail2@gmail.com:pass2

# Optional: Custom SMTP server (leave empty when using Gmail)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
