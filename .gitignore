.expo/
frontend/.expo/
dist/
web-build/
expo-env.d.ts

# Generated native build folders (Expo prebuild output)
frontend/android/
frontend/ios/
/ios
/android

# ── Environment / Secrets ─────────────────────────────────
.env
.env.local
.env*.local
frontend/.env
frontend/.env.local
backend/.env
backend/.env.local

# ── Native signing / certs ────────────────────────────────
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# ── Metro bundler ─────────────────────────────────────────
.metro-health-check*

# ── Debug logs ────────────────────────────────────────────
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# ── OS artifacts ──────────────────────────────────────────
.DS_Store
Thumbs.db
*.pem

# ── TypeScript ────────────────────────────────────────────
*.tsbuildinfo

# ── Build output ──────────────────────────────────────────
build/
dist/
out/

